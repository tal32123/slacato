{
  "name": "slacato",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.23.1"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @slacato/web --filter @slacato/api --filter @slacato/worker dev",
    "build": "pnpm -r build",
    "start": "pnpm --parallel --filter @slacato/api --filter @slacato/worker start",
    "lint": "pnpm lint:biome && pnpm lint:boundaries",
    "lint:biome": "biome lint apps packages scripts",
    "lint:boundaries": "eslint apps packages scripts",
    "format": "biome format --write apps packages scripts",
    "format:check": "biome format apps packages scripts",
    "check": "biome check apps packages scripts",
    "check:fix": "biome check --write apps packages scripts",
    "quality:ci": "biome ci apps packages scripts && pnpm lint:boundaries && pnpm typecheck",
    "typecheck": "tsc -b packages/contracts packages/core packages/infrastructure apps/web apps/api apps/worker --pretty false",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:ensure": "tsx scripts/ensure-e2e-database.ts",
    "fixtures:fetch": "tsx scripts/fetch-fixtures.ts",
    "fixtures:slack": "tsx scripts/generate-slack-fixtures.ts",
    "ingest:records": "tsx scripts/ingest.ts",
    "index:embeddings": "tsx scripts/index-embeddings.ts",
    "eval:deterministic": "tsx scripts/evaluate.ts retrieval",
    "eval:brief-quality": "tsx scripts/brief-quality.ts",
    "eval:brief-quality:live": "tsx scripts/brief-quality-live.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.11",
    "@slacato/infrastructure": "workspace:*",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "bullmq": "6.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "eslint": "^10.9.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "express": "^5.2.1",
    "jsdom": "^30.0.1",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "7.8.2",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11",
    "zod": "4.4.3"
  }
}
