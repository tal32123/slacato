{
  "name": "@slacato/worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "SLACATO_BOOTSTRAP=1 concurrently --kill-others --names compile,serve \"tsc -b --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "build": "nest build",
    "start": "SLACATO_BOOTSTRAP=1 node dist/main.js"
  },
  "dependencies": {
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@slacato/core": "workspace:*",
    "@slacato/infrastructure": "workspace:*",
    "bullmq": "6.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@types/node": "^26.4.0",
    "concurrently": "^9.2.1",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3"
  }
}
