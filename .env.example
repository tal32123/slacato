NODE_ENV=development
DATABASE_URL=postgresql://slacato:slacato@127.0.0.1:54329/slacato
REDIS_URL=redis://127.0.0.1:56379
WEB_ORIGIN=http://127.0.0.1:4173
SESSION_SECRET=replace-with-a-32-character-minimum-secret
# Initial-release development/demo provider default: deterministic, no network or Ollama credentials.
# API/Task-8 composition must supply its explicit scriptable mock fixture resolver.
AI_PROVIDER=mock
# Required only when AI_PROVIDER=ollama; keep real values server-side and out of source control.
# OLLAMA_API_KEY=replace-with-server-only-key
# OLLAMA_BASE_URL=https://ollama.com/api
# OLLAMA_CHAT_MODEL=replace-with-configured-chat-model
# OLLAMA_EMBEDDING_MODEL=replace-with-configured-embedding-model
# Simple OpenRouter mode uses fixed models and OpenRouter's default provider failover.
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=replace-with-server-only-key
# Verified free structured-output example; free endpoint availability and rate limits may change.
# OPENROUTER_CHAT_MODEL=google/gemini-3.5-flash-lite
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
LOG_LEVEL=info
# Sandbox reset ("Reset sandbox" in Settings). Absent means the capability does not exist: the API
# registers no reset routes and the interface renders no control. Two independent variables have to
# agree before it appears, so no single edit can point a working reset at the wrong database.
#   1. SLACATO_SANDBOX_RESET must be exactly "enabled". Nothing is inferred from NODE_ENV.
#   2. the connected database must be a recognized local demo name on a loopback host, or be named
#      exactly by SLACATO_SANDBOX_RESET_DATABASE (how a hosted sandbox opts in).
# SLACATO_SANDBOX_RESET=enabled
# SLACATO_SANDBOX_RESET_DATABASE=replace-with-the-exact-hosted-sandbox-database-name
